# ksu.config — SukiSU-Ultra + SUSFS kernel config fragment
#
# Merge this on top of exynos9830_defconfig + r8s.config when building with
# SukiSU-Ultra (ENABLE_KSU=true).
#
# CONFIG_KSU depends on: KPROBES && EXT4_FS
#   - EXT4_FS=y  already in exynos9830_defconfig
#   - KPROBES requires MODULES && HAVE_KPROBES — both true in this kernel
#   - HAVE_KPROBES=y already in exynos9830_defconfig (arm64 always provides it)
#
# SUSFS options (only active if SUSFS patches have been applied)
#   - CONFIG_KSU_SUSFS and related options below

# ── SukiSU-Ultra core ─────────────────────────────────────────────────────────
CONFIG_KPROBES=y
CONFIG_KSU=y
# CONFIG_KSU_DEBUG is not set
CONFIG_KSU_MANUAL_SU=y

# ── SUSFS (uncomment if ENABLE_SUSFS=true) ────────────────────────────────────
# These options only exist after the SUSFS patches have been applied.
# If the patches are present, they'll be merged; otherwise olddefconfig
# will ignore unknowns — but gate 2b in 04-build.sh will catch the failure.
CONFIG_KSU_SUSFS=y
CONFIG_KSU_SUSFS_SUS_PATH=y
CONFIG_KSU_SUSFS_SUS_MOUNT=y
CONFIG_KSU_SUSFS_SUS_KSTAT=y
CONFIG_KSU_SUSFS_SUS_OVERLAYFS=y
CONFIG_KSU_SUSFS_TRY_UMOUNT=y
CONFIG_KSU_SUSFS_AUTO_ADD_SUS_KSU_DEFAULT_MOUNT=y
CONFIG_KSU_SUSFS_AUTO_ADD_SUS_BIND_MOUNT=y
CONFIG_KSU_SUSFS_SUS_SU=y
CONFIG_KSU_SUSFS_SPOOF_UNAME=y
CONFIG_KSU_SUSFS_ENABLE_LOG=y
