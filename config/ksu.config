# ksu.config — KernelSU (official tiann/KernelSU v0.9.5) + classic SUSFS
#
# Merge this on top of exynos9830_defconfig + r8s.config when building with
# KernelSU (ENABLE_KSU=true) and SUSFS (ENABLE_SUSFS=true).
#
# CONFIG_KSU depends on: KPROBES
#   - KPROBES requires MODULES && HAVE_KPROBES — both true in this kernel
#   - HAVE_KPROBES=y already in exynos9830_defconfig (arm64 always provides it)
#   - KPROBES is enabled here because official KernelSU uses kprobes for its
#     non-GKI syscall hooks. (The susfs4ksu "disable kprobes" note applies only
#     to the deprecated sus_su fifo, which kernel-4.19 no longer ships.)
#
# SUSFS options come from simonpunk's classic susfs4ksu kernel-4.19 Kconfig,
# which is applied to the KernelSU driver by
# patches/10_enable_susfs_for_ksu_v0.9.5.patch.
#
# NOTE: SukiSU-Ultra-only (CONFIG_KSU_MANUAL_SU) and modern-ABI
# (CONFIG_KSU_SUSFS_SUS_MAP) options have been intentionally removed here.

# ── KernelSU core ─────────────────────────────────────────────────────────────
CONFIG_KPROBES=y
CONFIG_KSU=y
# CONFIG_KSU_DEBUG is not set

# ── SUSFS (classic kernel-4.19 ABI) ───────────────────────────────────────────
CONFIG_KSU_SUSFS=y
CONFIG_KSU_SUSFS_HAS_MAGIC_MOUNT=y
CONFIG_KSU_SUSFS_SUS_PATH=y
CONFIG_KSU_SUSFS_SUS_MOUNT=y
CONFIG_KSU_SUSFS_SUS_KSTAT=y
CONFIG_KSU_SUSFS_SUS_OVERLAYFS=y
CONFIG_KSU_SUSFS_TRY_UMOUNT=y
CONFIG_KSU_SUSFS_AUTO_ADD_SUS_KSU_DEFAULT_MOUNT=y
CONFIG_KSU_SUSFS_AUTO_ADD_SUS_BIND_MOUNT=y
CONFIG_KSU_SUSFS_SPOOF_UNAME=y
CONFIG_KSU_SUSFS_SPOOF_CMDLINE_OR_BOOTCONFIG=y
CONFIG_KSU_SUSFS_HIDE_KSU_SUSFS_SYMBOLS=y
CONFIG_KSU_SUSFS_OPEN_REDIRECT=y
CONFIG_KSU_SUSFS_ENABLE_LOG=y
