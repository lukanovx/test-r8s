# ============================================================
#  docker-minimal.config
#
#  Versao enxuta: SO o que o Docker realmente precisa.
#  Remove os tres grupos opcionais, que sao os suspeitos de
#  matar o boot cedo (controladores de cgroup sao inicializados
#  em cgroup_init_early(), ANTES do console - um panico ali nao
#  deixa rastro nenhum, que e exatamente o que observamos).
#
#  REMOVIDO em relacao ao docker-kernel.config:
#    - controladores de cgroup de rede (net_cls, net_prio)
#    - controlador de cgroup pids
#    - throttling de I/O por cgroup
#  Nada disso e exigido pelo dockerd; sao limites finos que o
#  Docker simplesmente nao oferece se o kernel nao tiver.
#
#  ATENCAO: nao escrever CONFIG_ logo apos "#" em comentario -
#  o merge_config.sh interpreta como ordem de desligar.
# ============================================================

# ---------- BLOQUEANTES ----------
CONFIG_IPC_NS=y
CONFIG_POSIX_MQUEUE=y
CONFIG_POSIX_MQUEUE_SYSCTL=y
CONFIG_CGROUP_DEVICE=y

# ---------- REDE (para -p porta:porta funcionar) ----------
CONFIG_BRIDGE=y
CONFIG_BRIDGE_NETFILTER=y
CONFIG_LLC=y
CONFIG_STP=y
CONFIG_NETFILTER_XT_MATCH_ADDRTYPE=y

# ---------- REAFIRMADAS (ja vem do defconfig base) ----------
CONFIG_OVERLAY_FS=y
CONFIG_VETH=y
