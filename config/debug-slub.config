# ============================================================================
#  debug-slub.config - memory-corruption diagnostics for the r8s panic hunt
# ============================================================================
#
# Merge on top of the normal config (i.e. together with ksu.config).
# This is a DIAGNOSTIC build, not for daily use.
#
# Why:
#   The recurring panic is
#       list_del corruption. prev->next should be ffffffc8c3495dd8,
#       but was                                   0000002dc3495dd8
#   i.e. the HIGH 32 bits of a kernel pointer were overwritten while the low
#   32 bits stayed intact - a wrong-offset / cross-object write.
#
#   DEBUG_LIST (already on) catches this, but it reports the VICTIM (an
#   inode_security_struct inside selinux_inode_free_security), not the
#   CULPRIT. Nothing in the current config can see the faulty write.
#
# IMPORTANT: scripts/kconfig/merge_config.sh appends this file verbatim to
# .config, and its directive pattern is
#     ^(# ){0,1}CONFIG_<name>[= ]
# so a prose comment written as "# CONFIG_FOO=y" WOULD be applied as a real
# setting. Always write bare option names in prose here (no leading prefix).
# ============================================================================

# SLUB debug machinery, enabled for every cache.
# Equivalent to booting with slub_debug=FZPU:
#   F = consistency checks on alloc/free
#   Z = redzones      -> an overflow past an object is caught
#   P = poisoning     -> a use-after-free is caught
#   U = user tracking -> records alloc/free stacks, so the report names the
#                        owner of the corrupted object
#
# COST: noticeably more memory and slower allocation. That is the price of
# attribution. Escape hatch: append 'slub_debug=-' to the kernel cmdline to
# switch it off again without rebuilding.
CONFIG_SLUB_DEBUG=y
CONFIG_SLUB_DEBUG_ON=y

# Stop merging slab caches of different types into one cache.
# With merging on (the default), SLUB aliases caches of compatible sizes, so
# inode_security_struct can end up sharing a slab with an unrelated object
# type. An overflow in THAT object then lands silently on the inode blob,
# which matches the corruption signature above exactly. Disabling merging
# isolates the caches so such a write becomes visible.
# CONFIG_SLAB_MERGE_DEFAULT is not set

# Hardening that turns silent freelist corruption into an explicit report.
CONFIG_SLAB_FREELIST_HARDENED=y

# ============================================================================
#  Deliberately NOT included
# ============================================================================
#   KASAN            - the gold standard: reports the exact faulty access with
#                      a full stack trace, including plain wrong-offset writes
#                      that never cross a slab boundary. Much heavier, and it
#                      may conflict with the LTO option this kernel requires
#                      to boot. Try it only if the redzones above miss the
#                      culprit.
#   DEBUG_PAGEALLOC  - page-granularity use-after-free only, and very
#                      expensive. Redundant with poisoning for slab objects.
