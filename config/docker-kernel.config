# ============================================================
#  docker-kernel.config
#
#  ARVORE CORRETA (verificada pelo hash do kernel em execucao):
#      https://github.com/LineageOS/android_kernel_samsung_universal9830
#      branch: lineage-23.2
#  O commit HEAD dessa branch e 88a015858b05, o mesmo que aparece
#  no uname do aparelho (4.19.325-cip126-st10-g88a015858b05).
#
#  NAO use o ExtremeXT/android_kernel_samsung_exynos990: esta em
#  4.19.87 e nao contem esse commit.
#
#  Aparelho : SM-G985F / y2s / LineageOS 23.2 / Android 16
#
#  COMO APLICAR
#      make O=out CC=clang exynos9830_defconfig
#      ./scripts/kconfig/merge_config.sh -m -O out out/.config \
#          arch/arm64/configs/y2s.config \
#          arch/arm64/configs/docker.config
#      make O=out CC=clang olddefconfig
#
#  ARMADILHA IMPORTANTE
#      O merge_config.sh trata "# CONFIG_X=y" como uma DEFINICAO
#      (e a forma que o Kconfig usa para "desligado"), nao como
#      comentario. Nunca escreva CONFIG_ logo depois do "#" para
#      documentar algo: isso DESLIGA a opcao silenciosamente.
#      Por isso, abaixo, toda mencao a uma opcao dentro de texto
#      vem depois de outra palavra.
# ============================================================

# ---------- BLOQUEANTES: o runc nao cria container sem estes ----------
# no exynos9830_defconfig os tres primeiros vem como "is not set"
CONFIG_IPC_NS=y
CONFIG_POSIX_MQUEUE=y
CONFIG_POSIX_MQUEUE_SYSCTL=y
CONFIG_CGROUP_DEVICE=y

# ---------- REDE: sem estes so funciona --network=host ----------
CONFIG_BRIDGE=y
CONFIG_BRIDGE_NETFILTER=y
CONFIG_LLC=y
CONFIG_STP=y
CONFIG_NETFILTER_XT_MATCH_ADDRTYPE=y
CONFIG_NETFILTER_XT_MATCH_IPVS=y
CONFIG_NETFILTER_XT_MARK=y
CONFIG_IP_NF_TARGET_REDIRECT=y
CONFIG_NF_NAT_MASQUERADE_IPV4=y
CONFIG_DUMMY=y

# ---------- RECOMENDADOS ----------
CONFIG_CGROUP_PIDS=y
CONFIG_CGROUP_BPF=y
CONFIG_BLK_DEV_THROTTLING=y
CONFIG_NET_CLS_CGROUP=y
CONFIG_CGROUP_NET_PRIO=y

# ---------- REAFIRMADAS ----------
# ja vem ligadas no defconfig base; repetidas aqui de proposito, para
# que uma futura mudanca no defconfig nao as derrube sem aviso.
CONFIG_OVERLAY_FS=y
CONFIG_VETH=y

# ---------- DELIBERADAMENTE FORA ----------
# nao habilitamos o namespace de usuario: ele e vetor conhecido de
# escalada de privilegio, vem desligado de proposito no Android e pode
# conflitar com o RKP da Samsung. O Docker comum nao precisa dele -
# so o modo rootless / userns-remap.  (opcao: USER_NS)
#
# redes overlay entre maquinas so fazem sentido em cluster, entao
# ficam de fora.  (opcoes: VXLAN, MACVLAN, IPVLAN)
